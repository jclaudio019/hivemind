FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /src/mcp/bundle/package.json ./mcp/bundle/package.json
COPY --from=build /src/mcp/bundle/server.js ./mcp/bundle/server.js
COPY --from=build /src/scripts/local-mcp.mjs ./scripts/local-mcp.mjs
ENTRYPOINT ["node", "/app/scripts/local-mcp.mjs"]
